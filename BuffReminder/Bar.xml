<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

	<!-- A missing buff: click to cast it. Action bar button art, as in
	     ActionButtonTemplate (slot background, masked icon, frame, mouseover). -->
	<Button name="BuffReminderButtonTemplate" inherits="SecureActionButtonTemplate" mixin="BuffReminderButtonMixin" virtual="true">
		<Size x="45" y="45"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Icon"/>
				<MaskTexture parentKey="IconMask" atlas="UI-HUD-ActionBar-IconFrame-Mask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent.Icon"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="Icon"/>
					</MaskedTextures>
				</MaskTexture>
				<Texture parentKey="SlotBackground" atlas="UI-HUD-ActionBar-IconFrame-Background" setAllPoints="true"/>
			</Layer>
		</Layers>
		<NormalTexture parentKey="NormalTexture" atlas="UI-HUD-ActionBar-IconFrame">
			<Size x="46" y="45"/>
			<Anchors>
				<Anchor point="TOPLEFT"/>
			</Anchors>
		</NormalTexture>
		<PushedTexture parentKey="PushedTexture" atlas="UI-HUD-ActionBar-IconFrame-Down">
			<Size x="46" y="45"/>
			<Anchors>
				<Anchor point="TOPLEFT"/>
			</Anchors>
		</PushedTexture>
		<HighlightTexture parentKey="HighlightTexture" atlas="UI-HUD-ActionBar-IconFrame-Mouseover">
			<Size x="46" y="45"/>
			<Anchors>
				<Anchor point="TOPLEFT"/>
			</Anchors>
		</HighlightTexture>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="OnEnter"/>
			<OnLeave function="GameTooltip_Hide"/>
			<OnDragStart method="OnDragStart"/>
			<OnDragStop method="OnDragStop"/>
		</Scripts>
	</Button>

	<!-- The row of missing buffs, with its heading. Out of combat it lists
	     the missing buffs; in combat its buttons can't move or hide, so it
	     holds one per buff that warns in combat and fades out the ones on. -->
	<Frame name="BuffReminderBar" parent="UIParent" mixin="BuffReminderBarMixin" movable="true" clampedToScreen="true" hidden="true">
		<Size x="45" y="64"/>
		<Anchors>
			<Anchor point="CENTER" x="0" y="160"/>
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Title" inherits="GameFontNormal">
					<Anchors>
						<Anchor point="TOP"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>
</Ui>
